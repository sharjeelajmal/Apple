# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Auth
BETTER_AUTH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI assistant (set one key)
# OpenRouter key (starts with sk-or-): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Faster model used for voice conversations
OPENROUTER_VOICE_MODEL=anthropic/claude-sonnet-5.5
# Or an Anthropic key (starts with sk-ant-)
ANTHROPIC_API_KEY=
